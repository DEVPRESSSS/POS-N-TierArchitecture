
@using PointOfSale.Utilities
@{
    @if (User.IsInRole(SD.Cashier))
    {
        Layout = "/Views/Shared/_Layout.cshtml";

    }else if (User.IsInRole(SD.Admin))
    {
        Layout = "/Views/Shared/_AdminLayout.cshtml";

    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";

    }
}
