@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="row g-0">
                    <!-- Logo/Icon Column -->
                    <div class="col-md-5 bg-primary d-flex align-items-center justify-content-center text-white rounded-start-4">
                        <div class="text-center p-4">
                            <!-- You can replace this with your actual logo -->
                            <div class="mb-4">
                                 <img src="@Url.Content("~/Logo/Logo.png")" 
                                 style="width: min(120px, 15vw); height: min(120px, 15vw); border-radius: 50%;" />
                            </div>
                            <h3 class="fw-bold mb-3">Welcome Back</h3>
                            <p class="mb-0 opacity-75">Sign in to your account to continue</p>
                        </div>
                    </div>

                    <!-- Login Form Column -->
                    <div class="col-md-7 rounded-end-4">
                        <div class="card-body p-5">
                            <form id="account" method="post">
                                <h2 class="card-title mb-4 fw-bold text-dark">Sign In</h2>

                                <div asp-validation-summary="ModelOnly"
                                     class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>
                                <div class="mb-3">
                                    <label asp-for="Input.Email" class="form-label fw-semibold">Email Address</label>
                                    <input asp-for="Input.Email" class="form-control"
                                           autocomplete="username"
                                           maxlength="40"
                                           pattern="[a-z0-9._%+-]+@@[a-z0-9.-]+\.[a-z]{2,}$"
                                           title="Please enter a valid email address"
                                           onkeypress="return event.charCode !== 32"
                                           placeholder="Enter your email" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                                    <div class="input-group">
                                        <input asp-for="Input.Password" type="password" class="form-control"
                                               autocomplete="current-password"
                                               maxlength="25"
                                               aria-required="true"
                                               onkeypress="return event.charCode !== 32"
                                               placeholder="Enter your password"
                                               id="passwordInput" />
                                        <button class="btn btn-outline-secondary border-1" type="button" id="togglePassword"
                                                style="border-color: #ced4da; border-left: 0 ; border-top-left-radius: 0; border-bottom-left-radius: 0;"
                                            aria-label="Toggle password visibility">
                                            <i class="mdi mdi-eye" id="passwordIcon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <div class="form-check">
                                        <input asp-for="Input.RememberMe" class="form-check-input" />
                                        <label asp-for="Input.RememberMe" class="form-check-label">
                                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                                        </label>
                                    </div>
                                </div>

                                <div class="d-grid mb-4">
                                    <button type="submit" class="btn btn-primary btn-lg w-100">Sign In</button>
                                </div>
                         @*        <div class="text-center">
                                    <div class="mb-2">
                                        <a id="forgot-password" asp-page="./Register"
                                           class="text-decoration-none">Forgot your password?</a>
                                    </div>

                                </div> *@

                                <div class="text-center">
                                    <div class="mb-2">
                                        <a id="forgot-password" asp-page="./ForgotPassword"
                                           class="text-decoration-none">Forgot your password?</a>
                                    </div>

                                </div>
                            </form>

                            @{
                                if ((Model.ExternalLogins?.Count ?? 0) > 0)
                                {
                                    <hr class="my-4">
                                    <div class="text-center">
                                        <p class="text-muted mb-3">Or sign in with</p>
                                        <form id="external-account" asp-page="./ExternalLogin"
                                              asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                            <div class="d-grid gap-2">
                                                @foreach (var provider in Model.ExternalLogins)
                                                {
                                                    <button type="submit" class="btn btn-outline-secondary"
                                                            name="provider" value="@provider.Name"
                                                            title="Log in using your @provider.DisplayName account">
                                                        <i class="me-2"></i>Continue with @provider.DisplayName
                                                    </button>
                                                }
                                            </div>
                                        </form>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle password visibility
        document.getElementById('togglePassword').addEventListener('click', function () {
            const passwordInput = document.getElementById('passwordInput');
            const passwordIcon = document.getElementById('passwordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordIcon.className = 'mdi mdi-eye-off';
                this.setAttribute('aria-label', 'Hide password');
            } else {
                passwordInput.type = 'password';
                passwordIcon.className = 'mdi mdi-eye';
                this.setAttribute('aria-label', 'Show password');
            }
        });
    </script>
}