@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="fas fa-key me-2"></i>
                        Forgot Password
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h5 class="text-muted">Enter your email address</h5>
                        <p class="small text-muted">
                            We'll send you a link to reset your password
                        </p>
                    </div>
                    
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger d-none" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold">
                                <i class="fas fa-envelope me-1"></i>
                                Email Address
                            </label>
                            <input asp-for="Input.Email" 
                                   type="email"
                                   class="form-control form-control-lg" 
                                   autocomplete="username" 
                                   aria-required="true"
                                   placeholder="Enter your email address"
                                   maxlength="40"
                                   pattern="[a-z0-9._%+-]+@@[a-z0-9.-]+\.[a-z]{2,}$"
                                   title="Please enter a valid email address"
                                   onkeypress="return event.charCode !== 32"
                                   required />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-paper-plane me-2"></i>
                                Send Reset Link
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-page="./Login" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Back to Login
                    </a>
                </div>
            </div>
            
            <!-- Help Text -->
           @*  <div class="text-center mt-3">
                <small class="text-muted">
                    Having trouble? 
                    <a href="/Contact" class="text-decoration-none">Contact Support</a>
                </small>
            </div> *@
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary if it has content
        $(document).ready(function() {
            const validationSummary = $('[asp-validation-summary="All"]');
            if (validationSummary.text().trim()) {
                validationSummary.removeClass('d-none');
            }
        });
    </script>
}