@model PointOfSale.Models.VMSale

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sale Receipt</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            font-size: 12px;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
        }

        .sale-info {
            margin-bottom: 20px;
        }

            .sale-info p {
                margin: 5px 0;
            }

        .products-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

            .products-table th, .products-table td {
                border: 1px solid #ddd;
                padding: 8px;
                text-align: left;
            }

            .products-table th {
                background-color: #f5f5f5;
                font-weight: bold;
            }

        .totals {
            margin-top: 20px;
            text-align: right;
            border-top: 2px solid #000;
            padding-top: 10px;
        }

            .totals p {
                margin: 5px 0;
            }

        .total-final {
            font-size: 16px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>SALES RECEIPT</h2>
        <p><strong>Receipt #:</strong> @Model.SaleNumber</p>
        <p><strong>Date:</strong> @Model.RegistrationDate</p>
    </div>

    <div class="sale-info">
        <p><strong>Customer:</strong> @(string.IsNullOrEmpty(Model.ClientName) ? "Walk-in Customer" : Model.ClientName)</p>
        <p><strong>Document:</strong> @(string.IsNullOrEmpty(Model.CustomerDocument) ? "N/A" : Model.CustomerDocument)</p>
        <p><strong>Payment Type:</strong> @(Model.PaymentType ?? "Cash")</p>
        <p><strong>Cashier:</strong> @(Model.Users ?? "System")</p>
    </div>

    <table class="products-table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DetailSales != null && Model.DetailSales.Any())
            {
                @foreach (var item in Model.DetailSales)
                {
                    <tr>
                        <td>@item.DescriptionProduct</td>
                        <td>@item.Quantity</td>
                        <td>$@string.Format("{0:N2}", item.Price)</td>
                        <td>$@string.Format("{0:N2}", item.Total)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No items found</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="totals">
        <p><strong>Subtotal:</strong> $@string.Format("{0:N2}", Model.Subtotal)</p>
        <p><strong>Taxes:</strong> $@string.Format("{0:N2}", Model.TotalTaxes)</p>
        <p class="total-final"><strong>Total:</strong> $@string.Format("{0:N2}", Model.Total)</p>
        <p><strong>Amount Paid:</strong> $@string.Format("{0:N2}", Model.AmountPaid)</p>
        <p><strong>Change:</strong> $@string.Format("{0:N2}", Model.Change)</p>
    </div>

    <div style="text-align: center; margin-top: 30px; font-size: 10px;">
        <p>Thank you for your purchase!</p>
    </div>
</body>
</html>