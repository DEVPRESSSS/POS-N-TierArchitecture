@using PointOfSale.Utilities

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevpressTech</title>

    <!-- GOOGLE FONTS -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500|Poppins:400,500,600,700|Roboto:400,500" rel="stylesheet" />

    <link href="https://cdn.materialdesignicons.com/4.4.95/css/materialdesignicons.min.css" rel="stylesheet" />

    <link id="sleek-css" rel="stylesheet" href="~/css/sleek.css" />
    <link href="~/plugins/toastr/toastr.css" rel="stylesheet">
    <link href="~/plugins/sweetalert/sweetalert.css" rel="stylesheet">
    <link href="~/Logo/Logo.png" rel="shortcut icon" />
     @await RenderSectionAsync("StylesPOS", required: false)
</head>
<body class="header-fixed sidebar-fixed sidebar-dark header-light" id="body">

    @if (User.IsInRole(SD.Cashier))
    {
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg shadow-sm bg-dark ">
            <div class="container-fluid">
                <a class="navbar-brand text-white" href="#">
                    DevpressTech
                </a>
                <button class="navbar-toggler text-white bg-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon "></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <div class="w-100 d-flex justify-content-center">
                        <ul class="navbar-nav">
                        @*     <li class="nav-item">
                                <a class="nav-link text-white active" href="@Url.Action("Dashboard","Home", new {area= "Cashier"})"><i class="bi bi-speedometer2"></i> Dashboard</a>
                            </li> *@
                            <li class="nav-item">
                                <a class="nav-link text-white" href="@Url.Action("NewSale", "Sales", new { area = "Cashier" })">
                                    <i class="mdi mdi-cart-plus"></i> New Sale
                                </a>
                            </li>


                         @*    <li class="nav-item">
                                <a class="nav-link text-white" href="#"><i class="bi bi-receipt"></i> My Sales</a>
                            </li> *@
                        </ul>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    }
    <!-- Content Wrapper -->
        <div class="content-wrapper">
            <div class="content">
                @RenderBody()
            </div>
        </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Update current time
        function updateDateTime() {
            const now = new Date();
            
            // Update time in navbar
            const timeElement = document.getElementById('currentTime');
            if (timeElement) {
                timeElement.textContent = now.toLocaleTimeString('en-US', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
            }
        }
        
        // Update time every second
        updateDateTime();
        setInterval(updateDateTime, 1000);
    </script>
    
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sleek.js"></script>
    <script src="~/plugins/sweetalert/sweetalert.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>
    <script src="~/plugins/loadingoverlay/loadingoverlay.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>